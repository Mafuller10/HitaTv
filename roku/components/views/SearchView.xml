<?xml version="1.0" encoding="utf-8"?>
<!-- Search across every source by title (and exact genre name). Results update as you type. -->
<component name="SearchView" extends="Group">
  <interface>
    <field id="catalogTask" type="node" />
    <field id="itemSelected" type="node" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="SearchView.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="0x0B0B0FFF" />
    <Label translation="[80,60]" text="Search" color="0xFFFFFFFF" font="font:LargeBoldSystemFont" />
    <MiniKeyboard id="keyboard" translation="[80,170]" />
    <Label id="hint" translation="[700,170]" width="1140" wrap="true" color="0x8C8C8CFF" font="font:SmallSystemFont"
           text="Type a title, or a genre like horror, western, anime or news." />
    <MarkupGrid id="grid" translation="[700,230]" itemComponentName="TileItem" numColumns="3" numRows="3"
                itemSize="[360,203]" itemSpacing="[24,40]" drawFocusFeedback="true"
                focusBitmapBlendColor="0xFF4D2EFF" vertFocusAnimationStyle="fixedFocusWrap" />
    <Timer id="debounce" duration="0.4" repeat="false" />
  </children>
</component>
